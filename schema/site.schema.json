{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site",
  "type": "object",
  "additionalProperties": false,
  "required": ["bannerLabel", "title", "subtitle"],
  "properties": {
    "bannerLabel": { "title": "Short site name (banner)", "type": "string", "minLength": 1 },
    "title": { "title": "Site title", "type": "string", "minLength": 1 },
    "subtitle": { "title": "Subtitle", "type": "string", "minLength": 1 },
    "favicon": { "title": "Favicon (file name)", "type": "string", "minLength": 1 },
    "logo": { "title": "Logo (file name)", "type": "string", "minLength": 1 },
    "theme": {
      "title": "Theme",
      "type": "string",
      "enum": ["light", "dark", "slate", "forest", "sepia"],
      "default": "light",
      "description": "Visual theme used for the built site."
    }
  }
}
