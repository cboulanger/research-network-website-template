{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "News",
  "type": "array",
  "x-editor": { "sort": { "by": "date", "order": "desc" }, "columns": ["date", "title"] },
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["date", "title", "url"],
    "properties": {
      "date": { "title": "Date", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "x-editor": { "widget": "date" } },
      "title": { "title": "Headline", "type": "string", "minLength": 1 },
      "url": { "title": "Link (URL or page name)", "type": "string", "pattern": "^(https?://[^\\s\"'<>]+|[^\\s\"'<>:/\\\\][^\\s\"'<>:\\\\]*)$" }
    }
  }
}
