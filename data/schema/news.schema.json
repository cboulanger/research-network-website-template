{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "News",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["date", "title", "url"],
    "properties": {
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "title": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "pattern": "^(https?://[^\\s\"'<>]+|[^\\s\"'<>:/\\\\][^\\s\"'<>:\\\\]*)$" }
    }
  }
}
