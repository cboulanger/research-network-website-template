# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# Personal access token for GitHub, used by `npm run deploy` (and the editor's
# "Deploy site" button) to trigger an on-demand rebuild (a workflow_dispatch on .github/workflows/ci.yml). Needs
# the "repo" scope (or "Actions: write" for a fine-grained token). Never read
# by the build or by the browser — it has nothing to do with site content.
GITHUB_TOKEN=
# The GitHub repository to rebuild, as owner/name (e.g. myname/my-site). Needed
# if you work from a ZIP download; with a git clone it is read from the remote.
GITHUB_REPOSITORY=

# Personal access token for a self-hosted GitLab instance, used for local
# tooling (creating the project, pushing, configuring repo/Pages settings via
# the GitLab API, and `npm run deploy` to trigger a Pages rebuild on demand)
# if you're hosting on GitLab instead of/alongside GitHub. `npm run deploy`
# triggers a rebuild on every forge whose token is set above — both at once
# if both GITHUB_TOKEN and GITLAB_TOKEN are set. Never read by the build or
# by the browser — it has nothing to do with site content.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.gwdg.de
# GitLab project path (group/name); like GITHUB_REPOSITORY, only needed without git.
GITLAB_PROJECT=

# After triggering a rebuild, `npm run deploy` (and the editor's "Deploy
# site" button) poll the forge's workflow/pipeline until it finishes or this
# many milliseconds pass, then report success or failure. Defaults: check
# every 10000ms (DEPLOY_POLL_INTERVAL_MS), give up after 300000ms/5min
# (DEPLOY_POLL_TIMEOUT_MS).
DEPLOY_POLL_INTERVAL_MS=
DEPLOY_POLL_TIMEOUT_MS=

# Optional: public address of the published site, shown as a link in the editor.
# Normally looked up from the forge's Pages settings; set this only to override
# it, e.g. when the site is reverse-proxied under a different domain.
SITE_URL=

# Where `npm run build`/`npm run validate` read content from. Build-time only
# — never read by the browser. Leave blank to use the committed generic
# content/ tree. Point it at .local/content for real (non-generic) local
# data, or at a remote URL (e.g. a WebDAV share) for a real deployment.
CONTENT_PATH=

# Only needed if CONTENT_PATH is a remote URL that requires Basic Auth. These
# ARE used by the build (locally and in CI, where they're set as protected/
# masked CI/CD variables) to fetch content — but only at build time. The
# built static output that ships to the browser never contains them. Leave
# both blank for a public/unauthenticated source.
CONTENT_USERNAME=
CONTENT_PASSWORD=

# Only needed if the Zotero group configured in data/publications.json is
# not publicly readable. A read-only key from https://www.zotero.org/settings/keys
# with access to that group. Build-time only.
ZOTERO_API_KEY=

# Per-request timeouts (milliseconds) for fetching remote content and the
# Zotero library at build time. Default 30000. On a timeout (or any fetch
# error) the build stops before writing anything, so an existing public/
# (and, in CI, the currently deployed site) stays as it was.
CONTENT_TIMEOUT_MS=
ZOTERO_TIMEOUT_MS=

# Port for the local data editor (`npm run edit`), which serves an admin UI
# at http://127.0.0.1:<port> for editing members/projects/events/news.
# Default 4848. Only used by `npm run edit` — never read by the build or by
# the browser.
EDIT_PORT=

# Optional: let site visitors propose edits/additions. Open any list page with
# ?edit to get Edit/Add buttons; submissions are posted to this ntfy topic and
# reviewed in the editor ("Inbox"). Leave NTFY_TOPIC blank to disable the
# feature entirely (nothing is built). The topic name ends up in the public
# site source — anyone who knows it can read and post to it — so use a long
# random name (letters, digits, "-", "_"; max 64 chars). All submissions are
# reviewed by hand before anything is saved. NTFY_SERVER defaults to
# https://ntfy.sh (messages are kept ~12h); point it at a self-hosted
# server for longer retention or access control. The form enforces a fixed
# 4096-byte message limit regardless of server.
NTFY_TOPIC=
NTFY_SERVER=
# How often the open editor checks the ntfy topic for new submissions, in
# milliseconds. Default 60000, minimum 10000. Only used by `npm run edit`.
INBOX_POLL_INTERVAL_MS=
