# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# Personal access token for gitlab.gwdg.de, used for local tooling (creating
# the project, pushing, configuring repo/Pages settings via the GitLab API,
# and `npm run deploy` to trigger a Pages rebuild on demand). Never read by
# the build or by the browser — it has nothing to do with site content.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.gwdg.de

# Where `npm run build`/`npm run validate` read content from. Build-time only
# — never read by the browser. Leave blank to use the committed generic
# content/ tree. Point it at .local/content for real (non-generic) local
# data, or at a remote URL (e.g. a WebDAV share) for a real deployment.
CONTENT_PATH=

# Only needed if CONTENT_PATH is a remote URL that requires Basic Auth. These
# ARE used by the build (locally and in CI, where they're set as protected/
# masked CI/CD variables) to fetch content — but only at build time. The
# built static output that ships to the browser never contains them. Leave
# both blank for a public/unauthenticated source.
CONTENT_USERNAME=
CONTENT_PASSWORD=

# Only needed if the Zotero group configured in data/publications.json is
# not publicly readable. A read-only key from https://www.zotero.org/settings/keys
# with access to that group. Build-time only.
ZOTERO_API_KEY=

# Per-request timeouts (milliseconds) for fetching remote content and the
# Zotero library at build time. Default 30000. On a timeout (or any fetch
# error) the build stops before writing anything, so an existing public/
# (and, in CI, the currently deployed site) stays as it was.
CONTENT_TIMEOUT_MS=
ZOTERO_TIMEOUT_MS=
